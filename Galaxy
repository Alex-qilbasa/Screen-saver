<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Cosmic Study Screen</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #05060f;
    cursor: none;
  }
  canvas {
    display: block;
  }
  #clock {
    position: fixed;
    top: 6%;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: rgba(255,255,255,0.75);
    font-weight: 200;
    letter-spacing: 4px;
    text-align: center;
    text-shadow: 0 0 20px rgba(150,180,255,0.4);
    user-select: none;
    pointer-events: none;
  }
  #time { font-size: 3.2rem; }
  #date { font-size: 0.95rem; opacity: 0.6; margin-top: 4px; letter-spacing: 2px; }
  #hint {
    position: fixed;
    bottom: 3%;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Segoe UI', system-ui, sans-serif;
    color: rgba(255,255,255,0.3);
    font-size: 0.8rem;
    letter-spacing: 1px;
    user-select: none;
    pointer-events: none;
    transition: opacity 1s;
  }
</style>
</head>
<body>
<canvas id="sky"></canvas>
<div id="clock">
  <div id="time">--:--</div>
  <div id="date">-</div>
</div>
<div id="hint">press F11 for fullscreen · move mouse to fade this out</div>

<script>
const canvas = document.getElementById('sky');
const ctx = canvas.getContext('2d');
let W, H;

function resize() {
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

// ---------- Stars ----------
const STAR_COUNT = 220;
let stars = [];
function makeStars() {
  stars = [];
  for (let i = 0; i < STAR_COUNT; i++) {
    stars.push({
      x: Math.random() * W,
      y: Math.random() * H,
      r: Math.random() * 1.4 + 0.3,
      baseAlpha: Math.random() * 0.6 + 0.3,
      twinkleSpeed: Math.random() * 0.02 + 0.005,
      phase: Math.random() * Math.PI * 2
    });
  }
}
makeStars();

// ---------- Nebula blobs ----------
const nebulae = [
  { x: 0.2, y: 0.3, r: 0.45, hue: 250, drift: 0.00006, phase: 0 },
  { x: 0.75, y: 0.6, r: 0.5, hue: 200, drift: 0.00004, phase: 2 },
  { x: 0.5, y: 0.8, r: 0.4, hue: 280, drift: 0.00005, phase: 4 }
];

// ---------- Shooting stars ----------
let shootingStars = [];
function spawnShootingStar() {
  const startX = Math.random() * W * 0.7 + W * 0.15;
  const startY = Math.random() * H * 0.3;
  const angle = Math.PI / 4 + (Math.random() * 0.3 - 0.15);
  shootingStars.push({
    x: startX, y: startY,
    vx: Math.cos(angle) * 9,
    vy: Math.sin(angle) * 9,
    life: 0,
    maxLife: 60 + Math.random() * 30,
    trail: []
  });
}
setInterval(() => {
  if (Math.random() < 0.6) spawnShootingStar();
}, 4000);

// ---------- Distant drifting "planet" ----------
const planet = { x: 0.85, y: 0.18, r: 46, hue: 235 };

let t = 0;

function draw() {
  t += 1;
  ctx.clearRect(0, 0, W, H);

  // base gradient sky
  const grad = ctx.createRadialGradient(W*0.5, H*0.4, 0, W*0.5, H*0.4, Math.max(W,H)*0.8);
  grad.addColorStop(0, '#0b0e24');
  grad.addColorStop(1, '#04050d');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  // nebula clouds
  nebulae.forEach(n => {
    const cx = (n.x + Math.sin(t * n.drift + n.phase) * 0.03) * W;
    const cy = (n.y + Math.cos(t * n.drift + n.phase) * 0.02) * H;
    const radius = n.r * Math.max(W, H);
    const ng = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
    ng.addColorStop(0, `hsla(${n.hue}, 70%, 55%, 0.10)`);
    ng.addColorStop(0.5, `hsla(${n.hue}, 70%, 45%, 0.05)`);
    ng.addColorStop(1, `hsla(${n.hue}, 70%, 30%, 0)`);
    ctx.fillStyle = ng;
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.fill();
  });

  // planet
  const px = planet.x * W, py = planet.y * H;
  const pg = ctx.createRadialGradient(px - planet.r*0.3, py - planet.r*0.3, planet.r*0.1, px, py, planet.r);
  pg.addColorStop(0, `hsla(${planet.hue}, 60%, 65%, 0.9)`);
  pg.addColorStop(1, `hsla(${planet.hue}, 60%, 25%, 0.9)`);
  ctx.fillStyle = pg;
  ctx.beginPath();
  ctx.arc(px, py, planet.r, 0, Math.PI * 2);
  ctx.fill();
  // faint ring glow
  ctx.strokeStyle = `hsla(${planet.hue}, 60%, 80%, 0.15)`;
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.ellipse(px, py, planet.r * 1.6, planet.r * 0.4, -0.3, 0, Math.PI * 2);
  ctx.stroke();

  // stars
  stars.forEach(s => {
    const alpha = s.baseAlpha + Math.sin(t * s.twinkleSpeed + s.phase) * 0.3;
    ctx.beginPath();
    ctx.fillStyle = `rgba(255,255,255,${Math.max(0, alpha)})`;
    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
    ctx.fill();
  });

  // shooting stars
  shootingStars.forEach(s => {
    s.trail.push({ x: s.x, y: s.y });
    if (s.trail.length > 18) s.trail.shift();
    s.x += s.vx;
    s.y += s.vy;
    s.life++;

    for (let i = 0; i < s.trail.length; i++) {
      const p = s.trail[i];
      const alpha = (i / s.trail.length) * (1 - s.life / s.maxLife);
      ctx.beginPath();
      ctx.fillStyle = `rgba(255,255,255,${Math.max(0, alpha)})`;
      ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
      ctx.fill();
    }
  });
  shootingStars = shootingStars.filter(s => s.life < s.maxLife);

  requestAnimationFrame(draw);
}
draw();

// ---------- Clock ----------
function updateClock() {
  const now = new Date();
  const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  const dateStr = now.toLocaleDateString([], { weekday: 'long', day: 'numeric', month: 'long' });
  document.getElementById('time').textContent = timeStr;
  document.getElementById('date').textContent = dateStr;
}
updateClock();
setInterval(updateClock, 1000 * 10);

// ---------- Fade UI on inactivity ----------
let hideTimer;
const hint = document.getElementById('hint');
const clock = document.getElementById('clock');
function showUI() {
  hint.style.opacity = 1;
  clearTimeout(hideTimer);
  hideTimer = setTimeout(() => { hint.style.opacity = 0; }, 3000);
}
window.addEventListener('mousemove', showUI);
showUI();
</script>
</body>
</html>
